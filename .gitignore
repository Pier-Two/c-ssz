# Build directory (out-of-source build folder)
build*/

# Prerequisites
*.d

# Object files
obj/
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

.DS_Store

# Coverage artifacts
*.gcov
*.gcda
*.gcno
coverage.info

# Ignore all files in the tests folder without extensions 
tests/*

# Un-ignore the fixtures folder inside tests (this re-includes the directory and its contents)
!tests/fixtures/

# Allow .c files (and other source files) in the tests folder
!tests/*.c
!tests/unit/
!tests/unit/*.c
!tests/spec/
!tests/spec/*.c
!tests/regression/
!tests/regression/*.c

# Allow .h files in the tests folder (if headers exist)
!tests/*.h
!tests/unit/*.h
!tests/spec/*.h
!tests/regression/*.h

# Ignore built binaries in bench folder
bench/*
!bench/*.c
!bench/*.h

# Doxygen generated output
docs/doxygen/

# IDE Settings
.vscode/*
